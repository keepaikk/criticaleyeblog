# DO NOT put secrets in this file.
# Copy to .env.local for local dev only. Dokploy uses its Environment tab.

# VITE_ADMIN_PATH — OPTIONAL build-time arg for the private newsroom desk.
# Generate a fresh path with: openssl rand -hex 6
# Prefix with /desk- and set it in Dokploy's Environment tab (Build Args).
# Leaving it unset disables the admin route entirely (safer).
# VITE_ADMIN_PATH="/desk-xxxxxxxxxxxx"
