# ─────────────────────────────────────────
# Critical Eye Blog — Environment Variables
# ─────────────────────────────────────────
# Set these in Dokploy's Environment tab (Runtime vars + Build Args)

# BUILD-TIME ONLY: Vite bakes this into the bundle.
# Optional. Leave unset to disable the admin route entirely (safest).
# Generate fresh: openssl rand -hex 6
VITE_ADMIN_PATH="/desk-a1b2c3d4e5f6"

# DATABASE (Runtime)
# Dokploy auto-generates this when you add a PostgreSQL database.
# Format: postgres://USER:PASSWORD@db:5432/criticaleye
DB_PASSWORD="your-strong-postgres-password"

# AUTH (Runtime)
# JWT secret for signing admin tokens. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-64-char-random-string"

# Admin login credentials (Runtime)
# The server auto-creates this user on first startup.
ADMIN_EMAIL="editor@criticaleye.org"
ADMIN_PASSWORD="your-very-strong-admin-password"
